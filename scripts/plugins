#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-all}"
FILTER="${2:-}"
BASE_PYTHON="${PLUGIN_VERIFY_PYTHON:-python3}"

mapfile_compat() {
  PLUGINS=()
  while IFS=$'\t' read -r id path plugin_path; do
    [[ -z "$FILTER" || "$id" == "$FILTER" ]] && PLUGINS+=("$id|$path|$plugin_path")
  done < <("$BASE_PYTHON" - "$ROOT/plugins.json" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as catalog:
    for plugin in json.load(catalog)["plugins"]:
        print(plugin["id"], plugin["path"], plugin["plugin_path"], sep="\t")
PY
)
  if [[ -n "$FILTER" && ${#PLUGINS[@]} -eq 0 ]]; then
    echo "unknown plugin: $FILTER" >&2
    exit 2
  fi
}

prepare_venv() {
  local dir="$1" venv="$dir/.venv-verify" python
  python="$venv/bin/python"
  if [[ ! -x "$python" ]]; then
    "$BASE_PYTHON" -m venv "$venv"
  fi
  "$python" -m pip install --disable-pip-version-check --upgrade 'pip>=21.3' >&2
  (cd "$dir" && "$python" -m pip install --disable-pip-version-check -e '.[dev]') >&2
  printf '%s\n' "$python"
}

refresh_checksums() {
  local dir="$1" sums="$dir/dist/SHA256SUMS" relative
  : > "$sums"
  while IFS= read -r relative; do
    (cd "$dir/dist" && shasum -a 256 "$relative") >> "$sums"
  done < <("$BASE_PYTHON" - "$dir/dist" <<'PY'
from pathlib import Path
import sys
root = Path(sys.argv[1])
for artifact in sorted((*root.glob("*.whl"), *root.glob("*.tar.gz")), key=lambda p: p.name):
    print(artifact.name)
PY
)
  (cd "$dir/dist" && shasum -a 256 -c "SHA256SUMS")
}

run_for_plugins() {
  local operation="$1" entry id rel plugin_rel dir python doctor_home
  mapfile_compat
  for entry in "${PLUGINS[@]}"; do
    IFS='|' read -r id rel plugin_rel <<< "$entry"
    dir="$ROOT/$rel"
    echo "==> $operation $id" >&2
    case "$operation" in
      test)
        python="$(prepare_venv "$dir")"
        (cd "$dir" && "$python" -m pytest -q)
        ;;
      build)
        python="$(prepare_venv "$dir")"
        (cd "$dir" && "$python" -m build)
        refresh_checksums "$dir"
        ;;
      doctor)
        doctor_home="$(mktemp -d "${TMPDIR:-/tmp}/hermes-plugin-doctor.XXXXXX")"
        trap 'rm -rf "$doctor_home"' RETURN
        HERMES_HOME="$doctor_home" hermes plugins doctor "$ROOT/$plugin_rel" --ci
        rm -rf "$doctor_home"
        trap - RETURN
        ;;
    esac
  done
}

case "$COMMAND" in
  list)
    mapfile_compat
    for entry in "${PLUGINS[@]}"; do
      IFS='|' read -r id rel _ <<< "$entry"
      printf '%s\t%s\n' "$id" "$rel"
    done
    ;;
  test|build|doctor) run_for_plugins "$COMMAND" ;;
  all)
    run_for_plugins test
    run_for_plugins build
    run_for_plugins doctor
    ;;
  *) echo "usage: $0 {list|test|build|doctor|all} [plugin-id]" >&2; exit 2 ;;
esac
